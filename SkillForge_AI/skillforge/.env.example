# SkillForge AI — environment variables
# Copy to .env and fill in values; never commit .env to version control.

# Database (Phase 14+)
DATABASE_URL=sqlite:///db/skillforge.db
# For production Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/skillforge

# LLM API key (Phase 13 — llm_layer only)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# REQUIRED for local development: path to the SQLite database.
# Setting this causes db_client.py to always use SQLite, even if
# DATABASE_URL is set to a Postgres URL by the hosting environment.
SKILLFORGE_DB_PATH=db/skillforge.db
