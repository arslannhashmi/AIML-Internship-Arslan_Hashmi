modules = ["nodejs-24", "python-3.12"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["uvicorn", "--app-dir", "skillforge", "backend.main:app", "--host", "0.0.0.0", "--port", "80"]

[deployment.env]
SKILLFORGE_DB_PATH = "skillforge/db/skillforge.db"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "rapidfuzz-cpp", "swig", "taskflow", "xcbuild"]
